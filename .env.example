# Copy to .env and fill in. Never commit real secrets.

PORT=8080
AUDITCHAIN_STORE_TYPE=sqlite
AUDITCHAIN_SQLITE_PATH=data/auditchain.db
AUDITCHAIN_EVIDENCE_DB=data/evidence.db
AUDITCHAIN_DEMO_ENABLED=false

AUDITCHAIN_API_KEY=
AUDITCHAIN_API_KEY_OFFICER=
AUDITCHAIN_API_KEY_REVIEWER=
AUDITCHAIN_API_KEY_AUDITOR=
AUDITCHAIN_API_KEY_ADMIN=
AUDITCHAIN_AUTH_ENFORCE=true
AUDITCHAIN_RATE_LIMIT=60

# Stable, high-entropy secret. Keep it server-side and unchanged to preserve actor pseudonyms.
AUDITCHAIN_ACTOR_HMAC_SECRET=

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auditchain
SPRING_DATASOURCE_USERNAME=auditchain
SPRING_DATASOURCE_PASSWORD=auditchain

AUDITCHAIN_ED25519_SEED=

# Public URL for the append-only signed checkpoint JSONL log.
AUDITCHAIN_ANCHOR_LOG_URL=https://raw.githubusercontent.com/kingayederikumo-boop/AuditChain/audit-anchors/anchors/log.jsonl

# Optional independent mirror configuration is set in GitHub Actions:
# Repository variable: AUDITCHAIN_ANCHOR_REPO=owner/auditchain-anchors
# Repository secret: AUDITCHAIN_ANCHOR_REPO_TOKEN=<fine-grained token for that repo only>

# Optional real vision HTTP endpoint. Empty = MockVisionProvider only.
# AUDITCHAIN_VISION_URL=https://your-provider.example/v1/analyse
# AUDITCHAIN_VISION_API_KEY=
